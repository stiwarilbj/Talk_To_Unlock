{
  "manifest_version": 3,
  "name": "Talk to Unlock — Voice Focus, Website Blocker & Productivity Coach",
  "short_name": "Talk Unlock",
  "version": "3.0.1",
  "description": "Voice-based focus sessions, website blocking, mindful pauses, schedules, and digital wellbeing tools for better productivity.",
  "permissions": [
    "storage",
    "alarms"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "shared.js",
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "styles.css"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ],
  "action": {
    "default_title": "Talk to Unlock — Voice Focus, Website Blocker & Productivity Coach",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "options_ui": {
    "page": "dashboard.html",
    "open_in_tab": true
  }
}
